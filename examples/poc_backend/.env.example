APP_NAME="S1 PoC"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_DISPLAY_TIMEZONE=Asia/Taipei
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=10080
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
AVATAR_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- S1: SMS OTP providers (server-side only; never commit real values) ---
# Provider and test mode are chosen in Filament. Test mode is ON by default: no paid SMS is sent.
MITAKE_USERNAME=
MITAKE_PASSWORD=
MITAKE_ENDPOINT=https://smsapi.mitake.com.tw/api/mtk/SmSend
EVERY8D_UID=
EVERY8D_PASSWORD=
EVERY8D_SITE=new.e8d.tw
SMSGO_USERNAME=
SMSGO_PASSWORD=
SMSGO_ENDPOINT=https://www.smsgo.com.tw/sms_gw/sendsms.aspx

# --- S8 M05: articles, comment blacklist and AI review of reported comments ---
# Shared article links: https://<host>/articles/{slug} (defaults to APP_URL).
ARTICLE_SHARE_BASE_URL=
# Optional JSON array of PCRE patterns replacing the default comment blacklist, e.g. ["/https?:\\/\\//iu"]
ARTICLE_COMMENT_BLACKLIST=
# AI review runs on the server only (queue worker). Driver "null" = no AI: reported comments
# reaching the threshold are hidden and handed to an admin. "openai_compatible" = chat-completions API.
AI_MODERATION_DRIVER=null
AI_MODERATION_ENDPOINT=https://api.openai.com/v1/chat/completions
AI_MODERATION_MODEL=gpt-4o-mini
# Never commit a real key; set it only in the hosting environment's secrets.
AI_MODERATION_API_KEY=
AI_MODERATION_TIMEOUT=15
