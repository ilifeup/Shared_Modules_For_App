{
  "name": "eachcore/s1-poc-backend",
  "description": "Disposable S1 Laravel integration test harness",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.3",
    "laravel/framework": "^12.0",
    "laravel/sanctum": "^4.0",
    "filament/filament": "^4.0",
    "spatie/laravel-permission": "^6.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../../packages/laravel/shared_core",
      "options": {"symlink": true}
    }
  ],
  "autoload": {
    "psr-4": {
      "EachCore\\S1Poc\\": "src/"
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
